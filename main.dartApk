import 'dart:async';
import 'package:flutter/material.dart';

void main() {
  runApp(const NazirSonsApp());
}

class NazirSonsApp extends StatefulWidget {
  const NazirSonsApp({super.key});

  @override
  State<NazirSonsApp> createState() => _NazirSonsAppState();
}

class _NazirSonsAppState extends State<NazirSonsApp> {
  Color primaryColor = const Color(0xFF0F172A);
  Color accentColor = const Color(0xFF10B981);

  void updateTheme(Color newPrimary, Color newAccent) {
    setState(() {
      primaryColor = newPrimary;
      accentColor = newAccent;
    });
  }

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Nazir Sons Attendance',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        scaffoldBackgroundColor: const Color(0xFFF8FAFC),
      ),
      home: AttendanceHomeScreen(
        primaryColor: primaryColor,
        accentColor: accentColor,
        onThemeChanged: updateTheme,
      ),
    );
  }
}

class Worker {
  int id;
  String name;
  String phone;
  double salary;
  String inTime;
  String outTime;
  int totalLeaves;
  double totalDeduction;
  double paidAmount;
  double remainingAmount;
  String status;

  Worker({
    required this.id,
    required this.name,
    this.phone = '',
    required this.salary,
    required this.inTime,
    required this.outTime,
    this.totalLeaves = 0,
    this.totalDeduction = 0.0,
    this.paidAmount = 0.0,
    this.remainingAmount = 0.0,
    this.status = 'ABSENT',
  });
}

class Manager {
  String name;
  String phone;
  double salary;
  String inTime;
  String outTime;
  int totalLeaves;
  double totalDeduction;
  double paidAmount;
  double remainingAmount;

  Manager({
    required this.name,
    this.phone = '',
    required this.salary,
    required this.inTime,
    required this.outTime,
    this.totalLeaves = 0,
    this.totalDeduction = 0.0,
    this.paidAmount = 0.0,
    this.remainingAmount = 0.0,
  });
}

class NoteItem {
  String title;
  String content;
  String date;

  NoteItem({required this.title, required this.content, required this.date});
}

class AttendanceHomeScreen extends StatefulWidget {
  final Color primaryColor;
  final Color accentColor;
  final Function(Color, Color) onThemeChanged;

  const AttendanceHomeScreen({
    super.key,
    required this.primaryColor,
    required this.accentColor,
    required this.onThemeChanged,
  });

  @override
  State<AttendanceHomeScreen> createState() => _AttendanceHomeScreenState();
}

class _AttendanceHomeScreenState extends State<AttendanceHomeScreen> {
  String appTitle = 'safii developers';
  String ceoName = 'Nazir Ahmed';
  String ceoPhone = '0300-1234567';
  
  // CEO Security & Notes State
  String ceoPin = '1234'; // Default PIN, CEO change kar sakta hai
  final List<NoteItem> ceoNotes = [
    NoteItem(title: 'Business Strategy', content: 'Future planning for expansion and machinery upgrades.', date: '1/10/2026'),
  ];

  Manager manager = Manager(
    name: 'Ali Khan',
    phone: '0301-9876543',
    salary: 50000,
    inTime: '09:00 AM',
    outTime: '06:00 PM',
    paidAmount: 20000,
    remainingAmount: 30000,
    totalLeaves: 1,
    totalDeduction: 1500,
  );

  String searchQuery = '';
  late String _currentTime;
  late String _currentDate;
  bool isLiveTime = true;
  Timer? _timer;

  final List<Worker> workers = [
    Worker(id: 1, name: 'Worker A', phone: '0302-1112233', salary: 30000, inTime: '09:00 AM', outTime: '05:00 PM', paidAmount: 10000, remainingAmount: 20000, status: 'ABSENT'),
    Worker(id: 2, name: 'Worker B', phone: '0303-4445566', salary: 35000, inTime: '09:30 AM', outTime: '05:30 PM', paidAmount: 15000, remainingAmount: 20000, status: 'ABSENT'),
  ];

  @override
  void initState() {
    super.initState();
    _updateDateTime();
    _startLiveTimer();
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  void _startLiveTimer() {
    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (isLiveTime) {
        _updateDateTime();
      }
    });
  }

  void _updateDateTime() {
    DateTime now = DateTime.now();
    setState(() {
      _currentDate = "${now.day}/${now.month}/${now.year}";
      int hour = now.hour;
      String period = hour >= 12 ? "PM" : "AM";
      hour = hour > 12 ? hour - 12 : (hour == 0 ? 12 : hour);
      String minute = now.minute.toString().padLeft(2, '0');
      String second = now.second.toString().padLeft(2, '0');
      _currentTime = "$hour:$minute:$second $period";
    });
  }

  Future<void> _pickDate() async {
    DateTime? pickedDate = await showDatePicker(
      context: context,
      initialDate: DateTime.now(),
      firstDate: DateTime(2020),
      lastDate: DateTime(2035),
    );

    if (pickedDate != null) {
      setState(() {
        _currentDate = "${pickedDate.day}/${pickedDate.month}/${pickedDate.year}";
      });
    }
  }

  Future<void> _pickTime() async {
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Row(
            children: const [
              Icon(Icons.edit, color: Colors.blue, size: 20),
              SizedBox(width: 8),
              Text('Edit / Manage Time'),
            ],
          ),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              ListTile(
                leading: const Icon(Icons.timer, color: Colors.green),
                title: const Text('Resume Live Timer (With Seconds)'),
                onTap: () {
                  setState(() {
                    isLiveTime = true;
                  });
                  Navigator.pop(context);
                },
              ),
              const Divider(),
              ListTile(
                leading: const Icon(Icons.edit_calendar, color: Colors.blue),
                title: const Text('Edit / Pick Custom Time'),
                onTap: () async {
                  Navigator.pop(context);
                  TimeOfDay? pickedTime = await showTimePicker(
                    context: context,
                    initialTime: TimeOfDay.now(),
                  );

                  if (pickedTime != null) {
                    setState(() {
                      isLiveTime = false;
                      final localizations = MaterialLocalizations.of(context);
                      _currentTime = localizations.formatTimeOfDay(pickedTime, alwaysUse24HourFormat: false);
                    });
                  }
                },
              ),
            ],
          ),
        );
      },
    );
  }

  // --- CEO PIN Lock & Notes Dialog ---
  void _promptCeoPin() {
    final TextEditingController pinController = TextEditingController();
    bool wrongPin = false;

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: Row(
                children: const [
                  Icon(Icons.lock, color: Colors.amber, size: 22),
                  SizedBox(width: 8),
                  Text('CEO Secret Notes (Locked)'),
                ],
              ),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const Text('Enter your 4-digit PIN code to view and manage your personal notes:', style: TextStyle(fontSize: 13)),
                  const SizedBox(height: 12),
                  TextField(
                    controller: pinController,
                    keyboardType: TextInputType.number,
                    obscureText: true,
                    maxLength: 4,
                    decoration: InputDecoration(
                      labelText: 'Enter PIN (Default: 1234)',
                      errorText: wrongPin ? 'Incorrect PIN code!' : null,
                      border: const OutlineInputBorder(),
                    ),
                  ),
                ],
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
                  onPressed: () {
                    if (pinController.text == ceoPin) {
                      Navigator.pop(context);
                      _openCeoNotesDashboard();
                    } else {
                      setDialogState(() {
                        wrongPin = true;
                      });
                    }
                  },
                  child: const Text('Unlock'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  void _openCeoNotesDashboard() {
    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Text('CEO Personal Notes'),
                  IconButton(
                    icon: const Icon(Icons.settings_outlined, size: 20),
                    tooltip: 'Change PIN',
                    onPressed: () {
                      _changeCeoPin();
                    },
                  ),
                ],
              ),
              content: SizedBox(
                width: double.maxFinite,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    ElevatedButton.icon(
                      style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
                      onPressed: () {
                        _addNewNoteDialog(() {
                          setDialogState(() {});
                        });
                      },
                      icon: const Icon(Icons.add, size: 16),
                      label: const Text('Add New Note'),
                    ),
                    const SizedBox(height: 10),
                    ceoNotes.isEmpty
                        ? const Padding(
                            padding: EdgeInsets.all(20.0),
                            child: Text('No notes added yet.', style: TextStyle(color: Colors.grey)),
                          )
                        : SizedBox(
                            height: 250,
                            child: ListView.builder(
                              shrinkWrap: true,
                              itemCount: ceoNotes.length,
                              itemBuilder: (context, index) {
                                final note = ceoNotes[index];
                                return Card(
                                  margin: const EdgeInsets.symmetric(vertical: 4),
                                  child: ListTile(
                                    title: Text(note.title, style: const TextStyle(fontWeight: FontWeight.bold)),
                                    subtitle: Column(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        Text(note.content, maxLines: 2, overflow: TextOverflow.ellipsis),
                                        const SizedBox(height: 2),
                                        Text(note.date, style: const TextStyle(fontSize: 10, color: Colors.grey)),
                                      ],
                                    ),
                                    trailing: IconButton(
                                      icon: const Icon(Icons.delete, color: Colors.red, size: 18),
                                      onPressed: () {
                                        setState(() {
                                          ceoNotes.removeAt(index);
                                        });
                                        setDialogState(() {});
                                      },
                                    ),
                                  ),
                                );
                              },
                            ),
                          ),
                  ],
                ),
              ),
              actions: [
                ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: widget.primaryColor, foregroundColor: Colors.white),
                  onPressed: () => Navigator.pop(context),
                  child: const Text('Close & Lock'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  void _addNewNoteDialog(VoidCallback onNoteAdded) {
    final TextEditingController titleController = TextEditingController();
    final TextEditingController contentController = TextEditingController();

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('New Secret Note'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(controller: titleController, decoration: const InputDecoration(labelText: 'Note Title')),
              const SizedBox(height: 8),
              TextField(
                controller: contentController,
                maxLines: 4,
                decoration: const InputDecoration(labelText: 'Write your notes here...'),
              ),
            ],
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () {
                if (titleController.text.isNotEmpty && contentController.text.isNotEmpty) {
                  setState(() {
                    ceoNotes.add(NoteItem(
                      title: titleController.text,
                      content: contentController.text,
                      date: _currentDate,
                    ));
                  });
                  Navigator.pop(context);
                  onNoteAdded();
                }
              },
              child: const Text('Save Note'),
            ),
          ],
        );
      },
    );
  }

  void _changeCeoPin() {
    final TextEditingController oldPinController = TextEditingController();
    final TextEditingController newPinController = TextEditingController();
    bool error = false;

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text('Change Security PIN'),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  TextField(
                    controller: oldPinController,
                    keyboardType: TextInputType.number,
                    obscureText: true,
                    maxLength: 4,
                    decoration: const InputDecoration(labelText: 'Current PIN'),
                  ),
                  const SizedBox(height: 8),
                  TextField(
                    controller: newPinController,
                    keyboardType: TextInputType.number,
                    obscureText: true,
                    maxLength: 4,
                    decoration: InputDecoration(
                      labelText: 'New 4-digit PIN',
                      errorText: error ? 'Incorrect old PIN!' : null,
                    ),
                  ),
                ],
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
                  onPressed: () {
                    if (oldPinController.text == ceoPin && newPinController.text.length == 4) {
                      setState(() {
                        ceoPin = newPinController.text;
                      });
                      Navigator.pop(context);
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('PIN successfully changed!')),
                      );
                    } else {
                      setDialogState(() {
                        error = true;
                      });
                    }
                  },
                  child: const Text('Update PIN'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  final List<Map<String, dynamic>> colorPresets = [
    {'name': 'Dark Navy', 'color': const Color(0xFF0F172A)},
    {'name': 'Emerald Green', 'color': const Color(0xFF059669)},
    {'name': 'Royal Blue', 'color': const Color(0xFF2563EB)},
    {'name': 'Deep Purple', 'color': const Color(0xFF7C3AED)},
    {'name': 'Crimson Red', 'color': const Color(0xFFDC2626)},
    {'name': 'Charcoal Grey', 'color': const Color(0xFF374151)},
    {'name': 'Teal Ocean', 'color': const Color(0xFF0D9488)},
  ];

  void _showColorPickerSheet() {
    showModalBottomSheet(
      context: context,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
      ),
      builder: (context) {
        return Container(
          padding: const EdgeInsets.all(16),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('Select Theme Color (7 Options)', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
              const SizedBox(height: 12),
              SizedBox(
                height: 70,
                child: ListView.builder(
                  scrollDirection: Axis.horizontal,
                  itemCount: colorPresets.length,
                  itemBuilder: (context, index) {
                    final item = colorPresets[index];
                    Color c = item['color'];
                    return GestureDetector(
                      onTap: () {
                        widget.onThemeChanged(c, c);
                        Navigator.pop(context);
                      },
                      child: Container(
                        margin: const EdgeInsets.only(right: 12),
                        child: Column(
                          children: [
                            CircleAvatar(
                              radius: 20,
                              backgroundColor: c,
                              child: widget.primaryColor == c ? const Icon(Icons.check, color: Colors.white, size: 18) : null,
                            ),
                            const SizedBox(height: 4),
                            Text(item['name'], style: const TextStyle(fontSize: 10)),
                          ],
                        ),
                      ),
                    );
                  },
                ),
              ),
              const Divider(),
              TextButton.icon(
                onPressed: () {
                  Navigator.pop(context);
                  _openColorMixer();
                },
                icon: const Icon(Icons.tune),
                label: const Text('Advanced Color Mixer'),
              ),
            ],
          ),
        );
      },
    );
  }

  void _openColorMixer() {
    double red = widget.primaryColor.r * 255;
    double green = widget.primaryColor.g * 255;
    double blue = widget.primaryColor.b * 255;

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            Color mixedColor = Color.fromRGBO(red.toInt(), green.toInt(), blue.toInt(), 1.0);

            return AlertDialog(
              title: const Text('Color Mixer (Custom Color)'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Container(
                      height: 50,
                      width: double.infinity,
                      decoration: BoxDecoration(color: mixedColor, borderRadius: BorderRadius.circular(8)),
                    ),
                    const SizedBox(height: 10),
                    const Text('Red', style: TextStyle(color: Colors.red)),
                    Slider(value: red, min: 0, max: 255, activeColor: Colors.red, onChanged: (val) => setDialogState(() => red = val)),
                    const Text('Green', style: TextStyle(color: Colors.green)),
                    Slider(value: green, min: 0, max: 255, activeColor: Colors.green, onChanged: (val) => setDialogState(() => green = val)),
                    const Text('Blue', style: TextStyle(color: Colors.blue)),
                    Slider(value: blue, min: 0, max: 255, activeColor: Colors.blue, onChanged: (val) => setDialogState(() => blue = val)),
                  ],
                ),
              ),
              actions: [
                TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(backgroundColor: mixedColor, foregroundColor: Colors.white),
                  onPressed: () {
                    widget.onThemeChanged(mixedColor, mixedColor);
                    Navigator.pop(context);
                  },
                  child: const Text('Apply'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  void _editAppTitle() {
    final TextEditingController titleController = TextEditingController(text: appTitle);
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('Edit App / Company Title'),
          content: TextField(controller: titleController, decoration: const InputDecoration(labelText: 'Company Title')),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () {
                setState(() => appTitle = titleController.text);
                Navigator.pop(context);
              },
              child: const Text('Save'),
            ),
          ],
        );
      },
    );
  }

  void _editCeo() {
    final TextEditingController nameController = TextEditingController(text: ceoName);
    final TextEditingController phoneController = TextEditingController(text: ceoPhone);

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('Edit CEO Details'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(controller: nameController, decoration: const InputDecoration(labelText: 'CEO Name')),
              const SizedBox(height: 8),
              TextField(controller: phoneController, keyboardType: TextInputType.phone, decoration: const InputDecoration(labelText: 'CEO Phone Number')),
            ],
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () {
                setState(() {
                  ceoName = nameController.text;
                  ceoPhone = phoneController.text;
                });
                Navigator.pop(context);
              },
              child: const Text('Save'),
            ),
          ],
        );
      },
    );
  }

  void _editManager() {
    final TextEditingController nameController = TextEditingController(text: manager.name);
    final TextEditingController phoneController = TextEditingController(text: manager.phone);
    final TextEditingController salaryController = TextEditingController(text: manager.salary.toString());
    final TextEditingController paidController = TextEditingController(text: manager.paidAmount.toString());
    final TextEditingController remainingController = TextEditingController(text: manager.remainingAmount.toString());
    final TextEditingController inTimeController = TextEditingController(text: manager.inTime);
    final TextEditingController outTimeController = TextEditingController(text: manager.outTime);
    final TextEditingController leavesController = TextEditingController(text: manager.totalLeaves.toString());
    final TextEditingController deductionController = TextEditingController(text: manager.totalDeduction.toString());

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('Edit Manager Details'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(controller: nameController, decoration: const InputDecoration(labelText: 'Manager Name')),
                const SizedBox(height: 8),
                TextField(controller: phoneController, keyboardType: TextInputType.phone, decoration: const InputDecoration(labelText: 'Phone Number')),
                const SizedBox(height: 8),
                TextField(controller: salaryController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Monthly Salary (Rs)')),
                const SizedBox(height: 8),
                TextField(controller: paidController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Paid Amount (Rs)')),
                const SizedBox(height: 8),
                TextField(controller: remainingController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Remaining Amount (Rs)')),
                const SizedBox(height: 8),
                TextField(controller: inTimeController, decoration: const InputDecoration(labelText: 'In Time')),
                const SizedBox(height: 8),
                TextField(controller: outTimeController, decoration: const InputDecoration(labelText: 'Out Time')),
                const SizedBox(height: 8),
                TextField(controller: leavesController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Total Leaves (Days)')),
                const SizedBox(height: 8),
                TextField(controller: deductionController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Total Deduction (Rs)')),
              ],
            ),
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () {
                setState(() {
                  manager.name = nameController.text;
                  manager.phone = phoneController.text;
                  manager.salary = double.tryParse(salaryController.text) ?? manager.salary;
                  manager.paidAmount = double.tryParse(paidController.text) ?? manager.paidAmount;
                  manager.remainingAmount = double.tryParse(remainingController.text) ?? manager.remainingAmount;
                  manager.inTime = inTimeController.text;
                  manager.outTime = outTimeController.text;
                  manager.totalLeaves = int.tryParse(leavesController.text) ?? manager.totalLeaves;
                  manager.totalDeduction = double.tryParse(deductionController.text) ?? manager.totalDeduction;
                });
                Navigator.pop(context);
              },
              child: const Text('Save All'),
            ),
          ],
        );
      },
    );
  }

  void _showManagerMonthlyYearlyReport() {
    double yearlySalary = manager.salary * 12;
    double yearlyPaid = manager.paidAmount * 12;
    double yearlyRemaining = manager.remainingAmount * 12;

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text('${manager.name} (Manager) - Ledger'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text('📅 MONTHLY REPORT', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.blue)),
                const SizedBox(height: 6),
                Text('• Monthly Salary: Rs ${manager.salary.toStringAsFixed(0)}'),
                Text('• Paid This Month: Rs ${manager.paidAmount.toStringAsFixed(0)}', style: const TextStyle(color: Colors.green)),
                Text('• Balance Remaining: Rs ${manager.remainingAmount.toStringAsFixed(0)}', style: const TextStyle(color: Colors.orange, fontWeight: FontWeight.bold)),
                Text('• Leaves Taken: ${manager.totalLeaves} Days'),
                Text('• Leave Deductions: Rs ${manager.totalDeduction.toStringAsFixed(0)}', style: const TextStyle(color: Colors.red)),
                const Divider(height: 24, thickness: 1),
                const Text('📊 YEARLY REPORT (Projection)', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.indigo)),
                const SizedBox(height: 6),
                Text('• Annual Base Salary: Rs ${yearlySalary.toStringAsFixed(0)}'),
                Text('• Estimated Total Paid: Rs ${yearlyPaid.toStringAsFixed(0)}', style: const TextStyle(color: Colors.green)),
                Text('• Estimated Annual Balance: Rs ${yearlyRemaining.toStringAsFixed(0)}', style: const TextStyle(color: Colors.orange, fontWeight: FontWeight.bold)),
              ],
            ),
          ),
          actions: [
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () => Navigator.pop(context),
              child: const Text('Close'),
            ),
          ],
        );
      },
    );
  }

  void _addNewWorker() {
    final TextEditingController nameController = TextEditingController();
    final TextEditingController phoneController = TextEditingController();
    final TextEditingController salaryController = TextEditingController();
    final TextEditingController paidController = TextEditingController();
    final TextEditingController remainingController = TextEditingController();
    final TextEditingController inTimeController = TextEditingController(text: '09:00 AM');
    final TextEditingController outTimeController = TextEditingController(text: '05:00 PM');

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('Add New Worker'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(controller: nameController, decoration: const InputDecoration(labelText: 'Worker Name')),
                TextField(controller: phoneController, keyboardType: TextInputType.phone, decoration: const InputDecoration(labelText: 'Phone Number')),
                TextField(controller: salaryController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Monthly Salary (Rs)')),
                TextField(controller: paidController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Paid Amount (Rs)')),
                TextField(controller: remainingController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Remaining Amount (Rs)')),
                TextField(controller: inTimeController, decoration: const InputDecoration(labelText: 'In Time')),
                TextField(controller: outTimeController, decoration: const InputDecoration(labelText: 'Out Time')),
              ],
            ),
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () {
                if (nameController.text.isNotEmpty) {
                  setState(() {
                    int newId = workers.isEmpty ? 1 : workers.last.id + 1;
                    workers.add(Worker(
                      id: newId,
                      name: nameController.text,
                      phone: phoneController.text,
                      salary: double.tryParse(salaryController.text) ?? 25000,
                      paidAmount: double.tryParse(paidController.text) ?? 0.0,
                      remainingAmount: double.tryParse(remainingController.text) ?? 0.0,
                      inTime: inTimeController.text,
                      outTime: outTimeController.text,
                    ));
                  });
                  Navigator.pop(context);
                }
              },
              child: const Text('Add'),
            ),
          ],
        );
      },
    );
  }

  void _editCompleteWorker(Worker worker) {
    final TextEditingController nameController = TextEditingController(text: worker.name);
    final TextEditingController phoneController = TextEditingController(text: worker.phone);
    final TextEditingController salaryController = TextEditingController(text: worker.salary.toString());
    final TextEditingController paidController = TextEditingController(text: worker.paidAmount.toString());
    final TextEditingController remainingController = TextEditingController(text: worker.remainingAmount.toString());
    final TextEditingController inTimeController = TextEditingController(text: worker.inTime);
    final TextEditingController outTimeController = TextEditingController(text: worker.outTime);
    final TextEditingController leavesController = TextEditingController(text: worker.totalLeaves.toString());
    final TextEditingController deductionController = TextEditingController(text: worker.totalDeduction.toString());

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text('Edit Details: ${worker.name}'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(controller: nameController, decoration: const InputDecoration(labelText: 'Worker Name')),
                const SizedBox(height: 8),
                TextField(controller: phoneController, keyboardType: TextInputType.phone, decoration: const InputDecoration(labelText: 'Phone Number')),
                const SizedBox(height: 8),
                TextField(controller: salaryController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Monthly Salary (Rs)')),
                const SizedBox(height: 8),
                TextField(controller: paidController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Paid Amount (Rs)')),
                const SizedBox(height: 8),
                TextField(controller: remainingController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Remaining Amount (Rs)')),
                const SizedBox(height: 8),
                TextField(controller: inTimeController, decoration: const InputDecoration(labelText: 'In Time')),
                const SizedBox(height: 8),
                TextField(controller: outTimeController, decoration: const InputDecoration(labelText: 'Out Time')),
                const SizedBox(height: 8),
                TextField(controller: leavesController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Total Leaves (Days)')),
                const SizedBox(height: 8),
                TextField(controller: deductionController, keyboardType: TextInputType.number, decoration: const InputDecoration(labelText: 'Total Deduction (Rs)')),
              ],
            ),
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancel')),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () {
                setState(() {
                  worker.name = nameController.text;
                  worker.phone = phoneController.text;
                  worker.salary = double.tryParse(salaryController.text) ?? worker.salary;
                  worker.paidAmount = double.tryParse(paidController.text) ?? worker.paidAmount;
                  worker.remainingAmount = double.tryParse(remainingController.text) ?? worker.remainingAmount;
                  worker.inTime = inTimeController.text;
                  worker.outTime = outTimeController.text;
                  worker.totalLeaves = int.tryParse(leavesController.text) ?? worker.totalLeaves;
                  worker.totalDeduction = double.tryParse(deductionController.text) ?? worker.totalDeduction;
                });
                Navigator.pop(context);
              },
              child: const Text('Save All'),
            ),
          ],
        );
      },
    );
  }

  void _showMonthlyYearlyReport(Worker worker) {
    double yearlySalary = worker.salary * 12;
    double yearlyPaid = worker.paidAmount * 12;
    double yearlyRemaining = worker.remainingAmount * 12;

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text('${worker.name} - Detailed Ledger'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text('📅 MONTHLY REPORT', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.blue)),
                const SizedBox(height: 6),
                Text('• Monthly Salary: Rs ${worker.salary.toStringAsFixed(0)}'),
                Text('• Paid This Month: Rs ${worker.paidAmount.toStringAsFixed(0)}', style: const TextStyle(color: Colors.green)),
                Text('• Balance Remaining: Rs ${worker.remainingAmount.toStringAsFixed(0)}', style: const TextStyle(color: Colors.orange, fontWeight: FontWeight.bold)),
                Text('• Leaves Taken: ${worker.totalLeaves} Days'),
                Text('• Leave Deductions: Rs ${worker.totalDeduction.toStringAsFixed(0)}', style: const TextStyle(color: Colors.red)),
                const Divider(height: 24, thickness: 1),
                const Text('📊 YEARLY REPORT (Projection)', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.indigo)),
                const SizedBox(height: 6),
                Text('• Annual Base Salary: Rs ${yearlySalary.toStringAsFixed(0)}'),
                Text('• Estimated Total Paid: Rs ${yearlyPaid.toStringAsFixed(0)}', style: const TextStyle(color: Colors.green)),
                Text('• Estimated Annual Balance: Rs ${yearlyRemaining.toStringAsFixed(0)}', style: const TextStyle(color: Colors.orange, fontWeight: FontWeight.bold)),
              ],
            ),
          ),
          actions: [
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
              onPressed: () => Navigator.pop(context),
              child: const Text('Close'),
            ),
          ],
        );
      },
    );
  }

  void _showCompanyAnalytics() {
    double totalPayroll = manager.salary + workers.fold(0, (sum, w) => sum + w.salary);
    double totalPaid = manager.paidAmount + workers.fold(0, (sum, w) => sum + w.paidAmount);
    double totalRemaining = manager.remainingAmount + workers.fold(0, (sum, w) => sum + w.remainingAmount);

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text('$appTitle - Analytics'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text('CEO: $ceoName ($ceoPhone)'),
              Text('Manager: ${manager.name} (${manager.phone})'),
              Text('Total Workers: ${workers.length}'),
              const Divider(),
              Text('Total Payroll: Rs $totalPayroll'),
              Text('Total Paid: Rs $totalPaid', style: const TextStyle(color: Colors.green)),
              Text('Total Remaining: Rs $totalRemaining', style: const TextStyle(color: Colors.orange, fontWeight: FontWeight.bold)),
            ],
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(context), child: const Text('Close')),
          ],
        );
      },
    );
  }

  void _markStatus(Worker worker, String status) {
    setState(() {
      worker.status = status;
    });
  }

  @override
  Widget build(BuildContext context) {
    final filteredWorkers = workers.where((worker) {
      return worker.name.toLowerCase().contains(searchQuery.toLowerCase());
    }).toList();

    return Scaffold(
      appBar: AppBar(
        title: InkWell(
          onTap: _editAppTitle,
          child: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(appTitle, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 18)),
              const SizedBox(width: 6),
              const Icon(Icons.edit, size: 14, color: Colors.amberAccent),
            ],
          ),
        ),
        backgroundColor: widget.primaryColor,
        centerTitle: true,
        actions: [
          // CEO Secret Notes Lock Button
          IconButton(
            icon: const Icon(Icons.lock_outline, color: Colors.amberAccent),
            onPressed: _promptCeoPin,
            tooltip: 'CEO Secret Notes (PIN Locked)',
          ),
          IconButton(
            icon: const Icon(Icons.palette, color: Colors.white),
            onPressed: _showColorPickerSheet,
            tooltip: '7 Color Presets & Mixer',
          ),
          IconButton(
            icon: const Icon(Icons.person_add, color: Colors.white),
            onPressed: _addNewWorker,
            tooltip: 'Add Worker',
          ),
        ],
      ),
      body: Column(
        children: [
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
            color: widget.primaryColor,
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Text('CEO: $ceoName', style: const TextStyle(color: Colors.white, fontSize: 13, fontWeight: FontWeight.bold)),
                          const SizedBox(width: 6),
                          InkWell(
                            onTap: _editCeo,
                            child: const Icon(Icons.edit, size: 14, color: Colors.greenAccent),
                          ),
                          const SizedBox(width: 8),
                          // Quick Notes Lock Icon next to CEO name
                          InkWell(
                            onTap: _promptCeoPin,
                            child: const Icon(Icons.lock, size: 16, color: Colors.amberAccent),
                          ),
                        ],
                      ),
                      const SizedBox(height: 8),
                      Row(
                        children: [
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Row(
                                  children: [
                                    Text('Manager: ${manager.name}', style: const TextStyle(color: Colors.amber, fontSize: 13, fontWeight: FontWeight.bold)),
                                    const SizedBox(width: 6),
                                    InkWell(
                                      onTap: _editManager,
                                      child: const Icon(Icons.edit, size: 14, color: Colors.greenAccent),
                                    ),
                                    const SizedBox(width: 8),
                                    InkWell(
                                      onTap: _showManagerMonthlyYearlyReport,
                                      child: const Icon(Icons.account_balance_wallet_outlined, size: 16, color: Color(0xFF0EA5E9)),
                                    ),
                                  ],
                                ),
                                if (manager.phone.isNotEmpty)
                                  Text('Ph: ${manager.phone}', style: const TextStyle(color: Colors.white60, fontSize: 10)),
                                Text('Salary: Rs ${manager.salary.toStringAsFixed(0)} | Paid: Rs ${manager.paidAmount.toStringAsFixed(0)}', style: const TextStyle(color: Colors.white70, fontSize: 11)),
                              ],
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                Column(
                  crossAxisAlignment: CrossAxisAlignment.end,
                  children: [
                    InkWell(
                      onTap: _pickDate,
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                        decoration: BoxDecoration(
                          color: Colors.white10,
                          borderRadius: BorderRadius.circular(6),
                          border: Border.all(color: Colors.amberAccent.withAlpha(128)),
                        ),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            const Icon(Icons.calendar_today, size: 12, color: Colors.amberAccent),
                            const SizedBox(width: 4),
                            Text(_currentDate, style: const TextStyle(color: Colors.amberAccent, fontSize: 11, fontWeight: FontWeight.w600)),
                            const SizedBox(width: 4),
                            const Icon(Icons.edit, size: 10, color: Colors.amberAccent),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 6),
                    InkWell(
                      onTap: _pickTime,
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                        decoration: BoxDecoration(
                          color: Colors.white10,
                          borderRadius: BorderRadius.circular(6),
                          border: Border.all(color: Colors.amberAccent.withAlpha(128)),
                        ),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            const Icon(Icons.access_time, size: 12, color: Colors.amberAccent),
                            const SizedBox(width: 4),
                            Text(_currentTime, style: const TextStyle(color: Colors.amberAccent, fontSize: 11, fontWeight: FontWeight.w600)),
                            const SizedBox(width: 4),
                            const Icon(Icons.edit, size: 10, color: Colors.amberAccent),
                          ],
                        ),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(12.0),
            child: TextField(
              onChanged: (value) => setState(() => searchQuery = value),
              decoration: InputDecoration(
                hintText: 'Search worker by name...',
                prefixIcon: const Icon(Icons.search),
                filled: true,
                fillColor: Colors.white,
                contentPadding: const EdgeInsets.symmetric(vertical: 0, horizontal: 16),
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                  borderSide: BorderSide.none,
                ),
                enabledBorder: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                  borderSide: BorderSide(color: Colors.grey.shade300),
                ),
                focusedBorder: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                  borderSide: BorderSide(color: widget.accentColor, width: 2),
                ),
              ),
            ),
          ),
          Expanded(
            child: filteredWorkers.isEmpty
                ? const Center(child: Text('No workers found!', style: TextStyle(color: Colors.grey, fontSize: 16)))
                : ListView.builder(
                    itemCount: filteredWorkers.length,
                    itemBuilder: (context, index) {
                      final worker = filteredWorkers[index];
                      return Card(
                        margin: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
                        child: Padding(
                          padding: const EdgeInsets.all(14.0),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Row(
                                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                children: [
                                  Row(
                                    children: [
                                      CircleAvatar(
                                        radius: 16,
                                        backgroundColor: const Color(0xFFF1F5F9),
                                        child: Text('${worker.id}', style: TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: widget.primaryColor)),
                                      ),
                                      const SizedBox(width: 10),
                                      Column(
                                        crossAxisAlignment: CrossAxisAlignment.start,
                                        children: [
                                          Text(worker.name, style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: Color(0xFF0F172A))),
                                          if (worker.phone.isNotEmpty)
                                            Text('Ph: ${worker.phone}', style: const TextStyle(fontSize: 11, color: Colors.grey)),
                                        ],
                                      ),
                                    ],
                                  ),
                                  Row(
                                    children: [
                                      IconButton(
                                        icon: Icon(Icons.edit_outlined, color: widget.accentColor),
                                        onPressed: () => _editCompleteWorker(worker),
                                      ),
                                      IconButton(
                                        icon: const Icon(Icons.account_balance_wallet_outlined, color: Color(0xFF0EA5E9)),
                                        onPressed: () => _showMonthlyYearlyReport(worker),
                                      ),
                                    ],
                                  ),
                                ],
                              ),
                              const SizedBox(height: 8),
                              Row(
                                children: [
                                  Container(
                                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                                    decoration: BoxDecoration(color: const Color(0xFFF0FDF4), borderRadius: BorderRadius.circular(6)),
                                    child: Text('In: ${worker.inTime}', style: const TextStyle(color: Color(0xFF16A34A), fontWeight: FontWeight.w600, fontSize: 12)),
                                  ),
                                  const SizedBox(width: 10),
                                  Container(
                                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                                    decoration: BoxDecoration(color: const Color(0xFFFFF7ED), borderRadius: BorderRadius.circular(6)),
                                    child: Text('Out: ${worker.outTime}', style: const TextStyle(color: Color(0xFFEA580C), fontWeight: FontWeight.w600, fontSize: 12)),
                                  ),
                                  const Spacer(),
                                  Container(
                                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                                    decoration: BoxDecoration(
                                      color: worker.status == 'PRESENT' ? widget.accentColor : const Color(0xFFEF4444),
                                      borderRadius: BorderRadius.circular(20),
                                    ),
                                    child: Text(worker.status, style: const TextStyle(color: Colors.white, fontSize: 11, fontWeight: FontWeight.bold)),
                                  ),
                                ],
                              ),
                              const SizedBox(height: 8),
                              Text(
                                'Salary: Rs ${worker.salary.toStringAsFixed(0)} | Paid: Rs ${worker.paidAmount.toStringAsFixed(0)} | Remaining: Rs ${worker.remainingAmount.toStringAsFixed(0)}',
                                style: const TextStyle(color: Color(0xFF334155), fontSize: 12, fontWeight: FontWeight.w600),
                              ),
                              const Divider(height: 20, color: Color(0xFFF1F5F9)),
                              Row(
                                mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                                children: [
                                  Expanded(
                                    child: ElevatedButton.icon(
                                      onPressed: worker.status == 'PRESENT' ? null : () => _markStatus(worker, 'PRESENT'),
                                      icon: const Icon(Icons.check_circle_outline, size: 16),
                                      label: const Text('Present'),
                                      style: ElevatedButton.styleFrom(
                                        backgroundColor: widget.accentColor,
                                        foregroundColor: Colors.white,
                                        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                                      ),
                                    ),
                                  ),
                                  const SizedBox(width: 12),
                                  Expanded(
                                    child: ElevatedButton.icon(
                                      onPressed: worker.status == 'ABSENT' ? null : () => _markStatus(worker, 'ABSENT'),
                                      icon: const Icon(Icons.highlight_off, size: 16),
                                      label: const Text('Absent'),
                                      style: ElevatedButton.styleFrom(
                                        backgroundColor: const Color(0xFFEF4444),
                                        foregroundColor: Colors.white,
                                        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                                      ),
                                    ),
                                  ),
                                ],
                              ),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
          ),
        ],
      ),
      bottomNavigationBar: Container(
        padding: const EdgeInsets.all(12),
        color: widget.primaryColor,
        child: Row(
          mainAxisAlignment: MainAxisAlignment.spaceAround,
          children: [
            ElevatedButton.icon(
              onPressed: _showCompanyAnalytics,
              icon: const Icon(Icons.analytics_outlined, size: 18),
              label: const Text('Company Analytics'),
              style: ElevatedButton.styleFrom(backgroundColor: Colors.white24, foregroundColor: Colors.white),
            ),
            ElevatedButton.icon(
              onPressed: _addNewWorker,
              icon: const Icon(Icons.add, size: 18),
              label: const Text('Add Worker'),
              style: ElevatedButton.styleFrom(backgroundColor: widget.accentColor, foregroundColor: Colors.white),
            ),
          ],
        ),
      ),
    );
  }
}
